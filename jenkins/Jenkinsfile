pipeline {
    agent any
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-id') 
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t devops-app:latest ./app'
            }
        }

        stage('Push to Registry'){
            steps{            
                sh 'docker tag devops-app:latest localhost:5000/devops-app:latest'
                sh 'docker push localhost:5000/devops-app:latest'             
            }
        }
    }
}